# Plantilla de variables del entorno local.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# .env esta ignorado por Git (ver .gitignore). Este archivo, que SI se versiona, solo
# contiene valores de juguete: sirven para desarrollo en la maquina de cada quien y no
# abren nada real. Las credenciales de produccion viven en el gestor de secretos del
# proveedor, nunca en un archivo del repositorio.

# ---------- PostgreSQL ----------
POSTGRES_DB=rindo
POSTGRES_USER=rindo
POSTGRES_PASSWORD=rindo_local
# Puerto publicado en el host. Cambialo si ya tienes otro PostgreSQL ocupando el 5432.
POSTGRES_PORT=5432

# ---------- Almacenamiento de objetos (Garage, compatible con S3) ----------
# El bucket y la clave se crean solos al arrancar el contenedor, a partir de estas
# variables. En produccion el equivalente es Supabase Storage; el backend usa el mismo
# protocolo S3 en ambos casos y no distingue uno de otro. Ver ADR-004.
S3_BUCKET=rindo-recibos
# Garage espera que la clave de acceso empiece por GK.
S3_ACCESS_KEY=GK0123456789abcdef0123456789
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_REGION=garage
S3_ENDPOINT=http://localhost:3900
S3_PORT=3900

# Secreto con el que los nodos de Garage se hablan entre si. Con un solo nodo no cifra
# nada relevante, pero el servicio no arranca sin el.
#   Regeneralo con: openssl rand -hex 32
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Protege /health y /metrics del puerto de administracion.
#   Regeneralo con: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=cmluZG9fbG9jYWxfYWRtaW5fdG9rZW5fZGVfZWplbXBsbw==
GARAGE_ADMIN_PORT=3903
