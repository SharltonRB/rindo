root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.java]
indent_size = 4

[*.{kt,kts,gradle}]
indent_size = 4

[*.{xml,xsd,wsdl}]
indent_size = 4

[*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}]
indent_size = 2

[*.{css,scss,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2

[{mvnw,gradlew}]
end_of_line = lf

[*.bat]
end_of_line = crlf
